{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/admin/:route/:id",
      "destination": "/api/admin?route=:route&id=:id"
    },
    {
      "source": "/api/admin/:route",
      "destination": "/api/admin?route=:route"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
